{
  "name": "ai-chatbot-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "cloudflare:types": "node scripts/generate-cloudflare-types.mjs",
    "cloudflare:check": "node scripts/check-cloudflare-env.mjs",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "latest",
    "@opennextjs/cloudflare": "latest",
    "@prisma/client": "latest",
    "ai": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "15.5.0",
    "next-themes": "latest",
    "openai": "latest",
    "pdf-parse": "latest",
    "prisma": "latest",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "~5.8.2",
    "wrangler": "latest"
  }
}
