# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project.
SUPABASE_URL="https://cetidfekkvnahxfixwwr.supabase.co"

# SUPABASE_ANON_KEY: The anon key of your Supabase project.
SUPABASE_ANON_KEY="your-anon-key"

# DATABASE_URL: The connection string for your Supabase PostgreSQL database.
# Never commit the actual password in this file. Provide it via a secure .env file locally.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.cetidfekkvnahxfixwwr.supabase.co:5432/postgres"
